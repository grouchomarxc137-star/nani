# ---------------------------------------------------------------------------
# Nani environment variables
# Copy to .env for local development. On Railway, set these in the service's
# Variables tab. Never commit a real .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local dev (npm run db):  postgresql://nani:nani@localhost:5433/nani
# Railway: reference the Postgres plugin with ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://nani:nani@localhost:5433/nani

# Shared password both people type at login. Server-side only — it is never
# sent to the browser and never appears in frontend source.
APP_PASSWORD=290126

# Secret used to sign session tokens. Generate a fresh random one for
# production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# How long a device stays signed in.
SESSION_DAYS=90

# Web Push (VAPID). Generate a pair with: npm run vapid
# The public key is served to the browser; the private key must stay secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Reminder scheduler. Runs inside the API process; no extra service needed.
SCHEDULER_CRON=*/5 * * * *
SCHEDULER_ENABLED=true

# Server
PORT=3000
NODE_ENV=development

# Only needed if the frontend is ever served from a different origin than the
# API. Leave empty when the API serves the built PWA, which is the default.
CORS_ORIGIN=
