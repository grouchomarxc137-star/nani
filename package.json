{
  "name": "nani",
  "private": true,
  "version": "0.1.0",
  "description": "Nani - a shared hydration companion for two people",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=web",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web && npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "test": "npm run test --workspace=server",
    "typecheck": "npm run typecheck --workspace=server && npm run typecheck --workspace=web",
    "prisma:generate": "npm run prisma:generate --workspace=server",
    "prisma:migrate": "npm run prisma:migrate --workspace=server",
    "prisma:deploy": "npm run prisma:deploy --workspace=server",
    "seed": "npm run seed --workspace=server",
    "vapid": "node scripts/generate-vapid.mjs",
    "postinstall": "npm run prisma:generate",
    "start:prod": "sh scripts/start-production.sh",
    "db:reset": "npm run prisma:reset --workspace=server"
  }
}
